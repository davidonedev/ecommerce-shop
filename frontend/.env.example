# Copie para .env.local (não versionado) e ajuste se precisar.

# URL base da API usada pelo navegador. Deixe vazio para usar /api, que o próprio Next
# encaminha para o back-end (veja API_PROXY_TARGET). Valor é gravado no build.
NEXT_PUBLIC_API_URL=

# Endereço do back-end Spring Boot para o proxy de /api (lido no build/start do Next).
API_PROXY_TARGET=http://localhost:8080
