# Copie este arquivo para .env (que NÃO é versionado) e ajuste os valores.

# --- Docker Compose (Postgres / Redis) ---
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=troque-esta-senha
# Porta 5434 evita conflito com PostgreSQL local (5432) e outros bancos em Docker (5433)
POSTGRES_PORT=5434
REDIS_PORT=6379
# Portas da API e do site quando rodam em containers (docker compose --profile full)
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Back-end (Spring Boot) ---
# O back-end lê estas variáveis do ambiente; exporte-as antes de rodar ou configure na sua IDE.
DB_URL=jdbc:postgresql://localhost:5434/ecommerce
DB_USER=ecommerce
DB_PASSWORD=troque-esta-senha
REDIS_HOST=localhost
REDIS_PORT=6379
# Segredo do JWT: gere um valor aleatório com 32+ bytes (ex.: `openssl rand -base64 48`)
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Painel administrativo (opcional) ---
# Primeiro administrador criado ao subir a API, se a conta ainda não existir (senha com 8+ caracteres).
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
# Dados de exemplo do catálogo e banners (perfil full). Deixe vazio para começar sem dados.
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed
