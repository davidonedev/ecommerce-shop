# Copie este arquivo para .env (que NÃO é versionado) e ajuste os valores.

# --- Docker Compose (Postgres / Redis) ---
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=troque-esta-senha
# Porta 5434 evita conflito com PostgreSQL local (5432) e outros bancos em Docker (5433)
POSTGRES_PORT=5434
REDIS_PORT=6379

# --- Back-end (Spring Boot) ---
# O back-end lê estas variáveis do ambiente; exporte-as antes de rodar ou configure na sua IDE.
DB_URL=jdbc:postgresql://localhost:5434/ecommerce
DB_USER=ecommerce
DB_PASSWORD=troque-esta-senha
REDIS_HOST=localhost
REDIS_PORT=6379
# Segredo do JWT: gere um valor aleatório com 32+ bytes (ex.: `openssl rand -base64 48`)
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:3000
